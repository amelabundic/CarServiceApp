@page "/registracija"
@using System.ComponentModel.DataAnnotations
@using AutoCentarBundic.Data
@using AutoCentarBundic.Services
@inject NavigationManager Navigation
@inject UserService UserService

<h3>Registracija korisnika</h3>

<EditForm Model="@model" OnValidSubmit="RegistrujKorisnika" @key="model">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Ime:</label>
        <InputText class="form-control" @bind-Value="model.Ime" autocomplete="off" />
    </div>

    <div class="form-group">
        <label>Prezime:</label>
        <InputText class="form-control" @bind-Value="model.Prezime" autocomplete="off" />
    </div>

    <div class="form-group">
        <label>Email:</label>
        <InputText class="form-control" @bind-Value="model.Email" autocomplete="off" />
    </div>

    <div class="form-group">
        <label>Lozinka:</label>
        <InputText type="password" class="form-control" @bind-Value="model.Password" autocomplete="new-password" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Registruj se</button>
</EditForm>

@if (!string.IsNullOrEmpty(poruka))
{
    <div class="alert alert-info mt-3">@poruka</div>
}

@code {
    private RegisterModel model = new();
    private string poruka;

    protected override void OnInitialized()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        model = new RegisterModel();
        poruka = string.Empty;
    }

    private async Task RegistrujKorisnika()
    {
        var user = new User
        {
            Ime = model.Ime,
            Prezime = model.Prezime,
            Email = model.Email,
            PasswordHash = model.Password
        };

        var rezultat = await UserService.Registruj(user);

        if (rezultat)
        {
            poruka = "Uspješna registracija!";
            StateHasChanged();

            await Task.Delay(500);

            ResetForm(); // reset forme prije navigacije

            Navigation.NavigateTo("/login", true); // force reload
        }
        else
        {
            poruka = "Korisnik sa ovim emailom već postoji.";
        }
    }
}







